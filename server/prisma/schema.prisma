generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Gedung {
  id_gedung           Int                 @id @default(autoincrement())
  nama_gedung         String              @unique
  kode_gedung         String              @unique
  jumlah_lantai       Int
  kapasitas_mahasiswa Int
  status_gedung       StatusGedung        @default(AKTIF)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  evaluasis           EvaluasiPembinaan[]
  fasilitators        Fasilitator[]
  kegiatans           KegiatanPembinaan[]
  mahasiswas          Mahasiswa[]
  rekaps              RekapAbsensi[]

  @@map("gedung")
}

model Mahasiswa {
  id_mahasiswa       Int                    @id @default(autoincrement())
  nim                String                 @unique
  nama               String
  email              String                 @unique
  password           String
  lantai             Int
  nomor_kamar        String
  alamat_asal        String?
  no_telp            String?
  foto_profil        String?
  kuota_izin_pulang  Int                    @default(10)
  status_reward      StatusRewardPunishment @default(AMAN)
  status_hunian      StatusHunian           @default(AKTIF)
  id_gedung          Int
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt
  id_fakultas        Int?
  id_jurusan         Int?
  id_tahun_akademik  Int?
  is_first_login     Boolean                @default(true)
  kehadirans         Kehadiran[]
  fakultas           fakultas?              @relation(fields: [id_fakultas], references: [id_fakultas])
  gedung             Gedung                 @relation(fields: [id_gedung], references: [id_gedung])
  jurusan            jurusan?               @relation(fields: [id_jurusan], references: [id_jurusan])
  tahun_akademik     TahunAkademik?         @relation(fields: [id_tahun_akademik], references: [id_tahun])
  notifikasis        Notifikasi[]
  push_subscriptions PushSubscription[]
  perizinans         Perizinan[]
  tugas_absen        PetugasAbsensi[]
  rekaps             RekapAbsensi[]

  @@index([id_fakultas], map: "mahasiswa_id_fakultas_fkey")
  @@index([id_gedung], map: "mahasiswa_id_gedung_fkey")
  @@index([id_jurusan], map: "mahasiswa_id_jurusan_fkey")
  @@index([id_tahun_akademik], map: "mahasiswa_id_tahun_akademik_fkey")
  @@map("mahasiswa")
}

model Fasilitator {
  id_fasilitator    Int                 @id @default(autoincrement())
  nip               String              @unique
  nama              String
  email             String              @unique
  password          String
  no_telp           String?
  foto_profil       String?
  id_gedung         Int
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  evaluasi_terima   EvaluasiPembinaan[]
  gedung            Gedung              @relation(fields: [id_gedung], references: [id_gedung])
  kegiatan_kelola   KegiatanPembinaan[]
  notifikasis       Notifikasi[]
  izin_validasi     Perizinan[]
  rekap_generate    RekapAbsensi[]
  pushSubscriptions PushSubscription[]

  @@index([id_gedung], map: "fasilitator_asrama_id_gedung_fkey")
  @@map("fasilitator_asrama")
}

model KetuaPokja {
  id_ketua_pokja    Int                 @id @default(autoincrement())
  nip               String              @unique
  nama              String
  email             String              @unique
  password          String
  no_telp           String?
  foto_profil       String?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  evaluasi_beri     EvaluasiPembinaan[]
  notifikasis       Notifikasi[]
  pushSubscriptions PushSubscription[]

  @@map("ketua_pokja_asrama")
}

model KegiatanPembinaan {
  id_kegiatan       Int              @id @default(autoincrement())
  nama_kegiatan     String
  deskripsi         String?          @db.Text
  tanggal_kegiatan  DateTime         @db.Date
  waktu_mulai       DateTime         @db.Time(0)
  waktu_selesai     DateTime         @db.Time(0)
  lokasi            String
  status_kegiatan   StatusKegiatan   @default(BERLANGSUNG)
  id_gedung         Int
  id_fasilitator    Int
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  qr_expires_at     DateTime?
  qr_token          String?          @unique
  id_jenis_kegiatan Int?
  fasilitator       Fasilitator      @relation(fields: [id_fasilitator], references: [id_fasilitator])
  gedung            Gedung           @relation(fields: [id_gedung], references: [id_gedung])
  jenis_kegiatan    jenis_kegiatan?  @relation(fields: [id_jenis_kegiatan], references: [id_jenis_kegiatan])
  kehadirans        Kehadiran[]
  petugas           PetugasAbsensi[]

  @@index([id_fasilitator], map: "kegiatan_pembinaan_id_fasilitator_fkey")
  @@index([id_gedung], map: "kegiatan_pembinaan_id_gedung_fkey")
  @@index([id_jenis_kegiatan], map: "kegiatan_pembinaan_id_jenis_kegiatan_fkey")
  @@map("kegiatan_pembinaan")
}

model PetugasAbsensi {
  id_petugas            Int               @id @default(autoincrement())
  lantai_tanggung_jawab Int
  tanggal_penugasan     DateTime          @default(now())
  status_tugas          StatusTugas       @default(DITUGASKAN)
  waktu_submit          DateTime?
  id_kegiatan           Int
  id_mahasiswa          Int
  created_at            DateTime          @default(now())
  input_kehadirans      Kehadiran[]
  kegiatan              KegiatanPembinaan @relation(fields: [id_kegiatan], references: [id_kegiatan])
  mahasiswa             Mahasiswa         @relation(fields: [id_mahasiswa], references: [id_mahasiswa])

  @@index([id_kegiatan], map: "petugas_absensi_id_kegiatan_fkey")
  @@index([id_mahasiswa], map: "petugas_absensi_id_mahasiswa_fkey")
  @@map("petugas_absensi")
}

model Kehadiran {
  id_kehadiran     Int               @id @default(autoincrement())
  status_kehadiran StatusKehadiran
  waktu_absen      DateTime          @default(now())
  keterangan       String?           @db.Text
  id_kegiatan      Int
  id_mahasiswa     Int
  id_petugas_input Int?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  kegiatan         KegiatanPembinaan @relation(fields: [id_kegiatan], references: [id_kegiatan])
  mahasiswa        Mahasiswa         @relation(fields: [id_mahasiswa], references: [id_mahasiswa])
  petugas_input    PetugasAbsensi?   @relation(fields: [id_petugas_input], references: [id_petugas])

  @@index([id_kegiatan], map: "kehadiran_id_kegiatan_fkey")
  @@index([id_mahasiswa], map: "kehadiran_id_mahasiswa_fkey")
  @@index([id_petugas_input], map: "kehadiran_id_petugas_input_fkey")
  @@map("kehadiran")
}

model RekapAbsensi {
  id_rekap                Int                    @id @default(autoincrement())
  bulan                   Int
  tahun                   Int
  total_kegiatan          Int
  total_hadir             Int
  total_izin              Int
  total_alpha             Int
  persentase_kehadiran    Decimal                @db.Decimal(5, 2)
  status_reward           StatusRewardPunishment
  tanggal_generate        DateTime               @default(now())
  tanggal_publikasi       DateTime?
  status_publikasi        StatusPublikasi        @default(DRAFT)
  id_gedung               Int
  id_mahasiswa            Int
  id_fasilitator_generate Int
  created_at              DateTime               @default(now())
  updated_at              DateTime               @updatedAt
  batas_alfa              Int?
  pengumuman_iqab         String?                @db.Text
  status_iqab             String?
  tanggal_mulai           DateTime?              @db.Date
  tanggal_selesai         DateTime?              @db.Date
  fasilitator             Fasilitator            @relation(fields: [id_fasilitator_generate], references: [id_fasilitator])
  gedung                  Gedung                 @relation(fields: [id_gedung], references: [id_gedung])
  mahasiswa               Mahasiswa              @relation(fields: [id_mahasiswa], references: [id_mahasiswa])

  @@index([id_fasilitator_generate], map: "rekap_absensi_id_fasilitator_generate_fkey")
  @@index([id_gedung], map: "rekap_absensi_id_gedung_fkey")
  @@index([id_mahasiswa], map: "rekap_absensi_id_mahasiswa_fkey")
  @@map("rekap_absensi")
}

model Perizinan {
  id_perizinan            Int                   @id @default(autoincrement())
  jenis_izin              JenisIzin
  tanggal_pengajuan       DateTime              @default(now())
  tanggal_mulai           DateTime              @db.Date
  tanggal_selesai         DateTime              @db.Date
  durasi_hari             Int
  alasan                  String                @db.Text
  dokumen_pendukung       String?
  status_pengajuan        StatusPengajuan       @default(MENUNGGU)
  tanggal_validasi        DateTime?
  catatan_fasilitator     String?               @db.Text
  id_mahasiswa            Int
  id_fasilitator_validasi Int?
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  foto_berangkat          String?
  foto_pulang             String?
  returned_at             DateTime?
  konfirmasis             KonfirmasiPerizinan[]
  fasilitator             Fasilitator?          @relation(fields: [id_fasilitator_validasi], references: [id_fasilitator])
  mahasiswa               Mahasiswa             @relation(fields: [id_mahasiswa], references: [id_mahasiswa])

  @@index([id_fasilitator_validasi], map: "perizinan_id_fasilitator_validasi_fkey")
  @@index([id_mahasiswa], map: "perizinan_id_mahasiswa_fkey")
  @@map("perizinan")
}

model KonfirmasiPerizinan {
  id_konfirmasi      Int             @id @default(autoincrement())
  jenis_konfirmasi   JenisKonfirmasi
  tanggal_konfirmasi DateTime        @default(now())
  foto_bukti         String?
  lokasi_konfirmasi  String?
  keterangan         String?         @db.Text
  id_perizinan       Int
  created_at         DateTime        @default(now())
  perizinan          Perizinan       @relation(fields: [id_perizinan], references: [id_perizinan])

  @@index([id_perizinan], map: "konfirmasi_perizinan_id_perizinan_fkey")
  @@map("konfirmasi_perizinan")
}

model EvaluasiPembinaan {
  id_evaluasi      Int         @id @default(autoincrement())
  tanggal_evaluasi DateTime    @default(now())
  catatan_evaluasi String      @db.Text
  tindak_lanjut    String?     @db.Text
  bulan_periode    Int
  tahun_periode    Int
  id_ketua_pokja   Int
  id_fasilitator   Int
  id_gedung        Int
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  fasilitator      Fasilitator @relation(fields: [id_fasilitator], references: [id_fasilitator])
  gedung           Gedung      @relation(fields: [id_gedung], references: [id_gedung])
  ketua_pokja      KetuaPokja  @relation(fields: [id_ketua_pokja], references: [id_ketua_pokja])

  @@index([id_fasilitator], map: "evaluasi_pembinaan_id_fasilitator_fkey")
  @@index([id_gedung], map: "evaluasi_pembinaan_id_gedung_fkey")
  @@index([id_ketua_pokja], map: "evaluasi_pembinaan_id_ketua_pokja_fkey")
  @@map("evaluasi_pembinaan")
}

model Notifikasi {
  id_notifikasi   Int            @id @default(autoincrement())
  judul           String
  pesan           String         @db.Text
  tanggal_kirim   DateTime       @default(now())
  status_baca     Boolean        @default(false)
  tipe_notifikasi TipeNotifikasi
  id_referensi    Int?
  dibaca_pada     DateTime?
  id_mahasiswa    Int?
  id_fasilitator  Int?
  id_ketua_pokja  Int?
  link_tujuan     String?
  fasilitator     Fasilitator?   @relation(fields: [id_fasilitator], references: [id_fasilitator])
  ketua_pokja     KetuaPokja?    @relation(fields: [id_ketua_pokja], references: [id_ketua_pokja])
  mahasiswa       Mahasiswa?     @relation(fields: [id_mahasiswa], references: [id_mahasiswa])

  @@index([id_fasilitator], map: "notifikasi_id_fasilitator_fkey")
  @@index([id_ketua_pokja], map: "notifikasi_id_ketua_pokja_fkey")
  @@index([id_mahasiswa], map: "notifikasi_id_mahasiswa_fkey")
  @@map("notifikasi")
}

model TahunAkademik {
  id_tahun   Int         @id @default(autoincrement())
  nama       String      @unique
  is_aktif   Boolean     @default(false)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  mahasiswa  Mahasiswa[]

  @@map("tahun_akademik")
}

model ResetToken {
  id_token   Int      @id @default(autoincrement())
  email      String   @unique
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("reset_token")
}

model fakultas {
  id_fakultas Int         @id @default(autoincrement())
  nama        String      @unique
  created_at  DateTime    @default(now())
  updated_at  DateTime
  jurusan     jurusan[]
  mahasiswa   Mahasiswa[]
}

model jenis_kegiatan {
  id_jenis_kegiatan  Int                 @id @default(autoincrement())
  nama_jenis         String              @unique
  is_wajib           Boolean             @default(false)
  created_at         DateTime            @default(now())
  updated_at         DateTime
  kegiatan_pembinaan KegiatanPembinaan[]
}

model jurusan {
  id_jurusan  Int         @id @default(autoincrement())
  nama        String
  id_fakultas Int
  created_at  DateTime    @default(now())
  updated_at  DateTime
  fakultas    fakultas    @relation(fields: [id_fakultas], references: [id_fakultas])
  mahasiswa   Mahasiswa[]

  @@index([id_fakultas], map: "jurusan_id_fakultas_fkey")
}

enum StatusGedung {
  AKTIF
  RENOVASI
  NON_AKTIF
}

enum StatusHunian {
  AKTIF
  ALUMNI
  KELUAR
  SKORSING
}

enum StatusRewardPunishment {
  AMAN
  PERINGATAN_1
  PERINGATAN_2
  DROP_OUT
  REWARD_TERBAIK
}

enum StatusKegiatan {
  BERLANGSUNG
  SELESAI
}

enum StatusTugas {
  DITUGASKAN
  SELESAI
  TIDAK_MENGERJAKAN
}

enum StatusKehadiran {
  HADIR
  IZIN
  SAKIT
  ALPHA
}

enum StatusPublikasi {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum JenisIzin {
  PULANG_KAMPUNG
  KEGIATAN_LUAR
}

enum StatusPengajuan {
  MENUNGGU
  DISETUJUI
  DITOLAK
  DIBATALKAN
  SELESAI
}

enum JenisKonfirmasi {
  SAMPAI_TUJUAN
  KEMBALI_ASRAMA
}

enum TipeNotifikasi {
  INFO
  PERINGATAN
  PENGUMUMAN
  IZIN
  FOTO_BERANGKAT
  FOTO_PULANG
}

model PushSubscription {
  id             Int      @id @default(autoincrement())
  endpoint       String   @db.Text
  keys_p256dh    String   @db.Text
  keys_auth      String   @db.Text
  id_mahasiswa   Int?
  id_fasilitator Int?
  id_ketua_pokja Int?
  created_at     DateTime @default(now())

  mahasiswa   Mahasiswa?   @relation(fields: [id_mahasiswa], references: [id_mahasiswa], onDelete: Cascade)
  fasilitator Fasilitator? @relation(fields: [id_fasilitator], references: [id_fasilitator], onDelete: Cascade)
  ketua_pokja KetuaPokja?  @relation(fields: [id_ketua_pokja], references: [id_ketua_pokja], onDelete: Cascade)
}
